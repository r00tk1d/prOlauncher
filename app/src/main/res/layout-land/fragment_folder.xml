<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/folderMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    tools:context=".ui.FolderFragment">

    <LinearLayout
        android:id="@+id/folderAppsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="74dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingVertical="@dimen/home_app_padding_vertical">

        <TextView
            android:id="@+id/folderApp1"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_1"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp2"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_2"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp3"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_3"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp4"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_4"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp5"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_5"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp6"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_6"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp7"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_7"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp8"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_8"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp9"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_9"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/folderApp10"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_10"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFolderName"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:paddingVertical="6dp"
        android:text="‹ "
        tools:text="‹ Folder" />

    <TextView
        android:id="@+id/tvFolderHint"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="48dp"
        android:text="@string/empty_folder_tip"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
